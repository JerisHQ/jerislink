<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>org.jeris.jerislink.video-watchdog</string>
  <key>ProgramArguments</key><array><string>/bin/zsh</string><string>__HOME__/Library/Application Support/JerisLink/bin/video-watchdog.zsh</string></array>
  <key>RunAtLoad</key><true/><key>KeepAlive</key><true/><key>ThrottleInterval</key><integer>5</integer>
  <key>StandardOutPath</key><string>/tmp/jerislink-video-watchdog.out</string>
  <key>StandardErrorPath</key><string>/tmp/jerislink-video-watchdog.err</string>
</dict></plist>
