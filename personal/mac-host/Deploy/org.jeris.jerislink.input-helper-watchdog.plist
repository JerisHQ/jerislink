<plist version="1.0"><dict>
  <key>Label</key><string>org.jeris.jerislink.input-helper-watchdog</string>
  <key>ProgramArguments</key><array><string>__HOME__/Library/Application Support/JerisLink/bin/input-helper-watchdog.zsh</string></array>
