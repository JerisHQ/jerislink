<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>org.jeris.jerislink.agent.input-helper</string>
	<key>BundleProgram</key>
	<string>Contents/Helpers/JerisLink Input Helper.app/Contents/MacOS/JerisLinkInputHelper</string>
	<key>ProgramArguments</key>
	<array>
		<string>JerisLinkInputHelper</string>
	</array>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>org.jeris.jerislink.host</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>5</integer>
	<key>StandardOutPath</key>
	<string>/tmp/jerislink-input-helper.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/jerislink-input-helper.err</string>
</dict>
</plist>
