#include <windows.h>
#include "resource.h"
#include "version.h"

IDI_JERISLINK ICON "jerislink.ico"

// Settings and volume windows: dark theme from the viewer's title bar, drawn in
// viewer.cpp (WM_CTLCOLOR*, owner-draw buttons, trackbar custom draw). Edit
// boxes have no border of their own; the dialog paints a rounded field around
// each one, 4 x 3 dialog units larger. The footer band starts at y = 201
// (settings) and y = 70 (volume); keep kSettingsFooterTop / kVolumeFooterTop
// in viewer.cpp in step. Trackbar style 0x0010 = TBS_HORZ | TBS_NOTICKS.
IDD_VIDEO_SETTINGS DIALOGEX 0, 0, 300, 231
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_CLIPCHILDREN
CAPTION "JerisLink Settings"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Settings", IDC_UI_TITLE, 14, 8, 272, 16, SS_NOPREFIX
    LTEXT           "Video, audio and keyboard preferences", IDC_UI_SUBTITLE, 14, 25, 272, 9, SS_NOPREFIX

    LTEXT           "VIDEO", IDC_UI_SECTION_VIDEO, 14, 42, 272, 9, SS_NOPREFIX
    LTEXT           "Codec", IDC_UI_LABEL_CODEC, 14, 54, 132, 9, SS_NOPREFIX
    COMBOBOX        IDC_VIDEO_CODEC, 14, 65, 132, 80, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Bitrate", IDC_UI_LABEL_BITRATE, 156, 54, 70, 9, SS_NOPREFIX
    RTEXT           "", IDC_BITRATE_VALUE, 226, 54, 60, 9, SS_NOPREFIX
    CONTROL         "Auto", IDC_BITRATE_AUTO, "Button", BS_OWNERDRAW | WS_TABSTOP, 156, 65, 38, 16
    CONTROL         "", IDC_VIDEO_BITRATE, "msctls_trackbar32", 0x0010 | WS_TABSTOP, 196, 65, 92, 16
    LTEXT           "Untick Auto to set 4-100 Mbps.", IDC_UI_HINT_BITRATE, 156, 84, 130, 9, SS_NOPREFIX

    LTEXT           "AUDIO", IDC_UI_SECTION_AUDIO, 14, 100, 272, 9, SS_NOPREFIX
    LTEXT           "Playback volume", IDC_UI_LABEL_VOLUME, 14, 113, 70, 9, SS_NOPREFIX
    CONTROL         "", IDC_VOLUME_SLIDER, "msctls_trackbar32", 0x0010 | WS_TABSTOP, 84, 109, 166, 16
    RTEXT           "100%", IDC_VOLUME_VALUE, 252, 113, 34, 9, SS_NOPREFIX
    CONTROL         "Mute (Ctrl+Alt+M)", IDC_VOLUME_MUTE, "Button", BS_OWNERDRAW | WS_TABSTOP, 14, 127, 110, 12
    LTEXT           "How loud the Mac's audio plays on this PC. Applies right away.", IDC_UI_HINT_VOLUME, 14, 142, 272, 9, SS_NOPREFIX

    LTEXT           "KEYBOARD", IDC_UI_SECTION_KEYBOARD, 14, 158, 272, 9, SS_NOPREFIX
    LTEXT           "Key layout", IDC_UI_LABEL_KEYBOARD, 14, 171, 70, 9, SS_NOPREFIX
    COMBOBOX        IDC_KEYBOARD_PRESET, 84, 167, 202, 80, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Mac: Win = Cmd. Windows: Ctrl = Cmd, Win = Control. Applies right away.", IDC_UI_HINT_KEYBOARD, 14, 185, 272, 9, SS_NOPREFIX

    LTEXT           "Volume and keyboard apply now. Video applies when you reconnect.", IDC_APPLY_NOTE, 14, 207, 166, 18, SS_NOPREFIX
    CONTROL         "Cancel", IDCANCEL, "Button", BS_OWNERDRAW | WS_TABSTOP, 186, 208, 48, 16
    CONTROL         "Save", IDOK, "Button", BS_OWNERDRAW | WS_TABSTOP, 238, 208, 48, 16
END

// Modeless "Volume..." window. Only changes how loud the Mac's audio plays on
// this PC (this app's audio session); it never touches the Mac.
IDD_AUDIO_VOLUME DIALOGEX 0, 0, 210, 94
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_CLIPCHILDREN
CAPTION "Playback Volume"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Mac audio on this PC", IDC_UI_TITLE, 10, 7, 190, 13, SS_NOPREFIX
    LTEXT           "Playback volume on this PC only. Applies right away.", IDC_UI_SUBTITLE, 10, 21, 190, 9, SS_NOPREFIX
    LTEXT           "Volume", IDC_UI_LABEL_VOLUME, 10, 39, 34, 9, SS_NOPREFIX
    CONTROL         "", IDC_VOLUME_SLIDER, "msctls_trackbar32", 0x0010 | WS_TABSTOP, 44, 35, 122, 16
    RTEXT           "100%", IDC_VOLUME_VALUE, 166, 39, 34, 9, SS_NOPREFIX
    CONTROL         "Mute (Ctrl+Alt+M)", IDC_VOLUME_MUTE, "Button", BS_OWNERDRAW | WS_TABSTOP, 10, 55, 110, 12
    CONTROL         "Close", IDCANCEL, "Button", BS_OWNERDRAW | WS_TABSTOP, 152, 75, 48, 14
END

// Launch screen (mockup A2): two columns. Left: app icon (painted), headline,
// tagline, theme picker, ready state. Right: tabs "Host address" and "Join
// with a code" (reserved, not built yet), the host field, Connect and the
// Advanced settings row. Footer band from y = 238; keep kLaunchFooterTop in
// viewer.cpp in step. The icon, column divider, tab underline, row dividers
// and the ready dot are painted in viewer.cpp (paintLaunchExtras).
IDD_LAUNCH DIALOGEX 0, 0, 460, 262
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX | WS_CLIPCHILDREN
CAPTION "JerisLink"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Your Mac,\nwithin reach.", IDC_LAUNCH_HERO, 18, 56, 150, 46, SS_NOPREFIX
    LTEXT           "A direct connection across your tailnet.", IDC_LAUNCH_TAGLINE, 18, 106, 150, 18, SS_NOPREFIX
    LTEXT           "THEME", IDC_UI_SECTION_THEME, 18, 140, 150, 9, SS_NOPREFIX
    CONTROL         "Green", IDC_THEME_GREEN, "Button", BS_OWNERDRAW | WS_TABSTOP, 18, 152, 58, 16
    CONTROL         "Blue", IDC_THEME_BLUE, "Button", BS_OWNERDRAW | WS_TABSTOP, 80, 152, 58, 16
    LTEXT           "READY TO CONNECT", IDC_LAUNCH_READY, 28, 218, 140, 9, SS_NOPREFIX

    LTEXT           "NEW SESSION", IDC_LAUNCH_EYEBROW, 196, 18, 250, 9, SS_NOPREFIX
    LTEXT           "Start a connection", IDC_UI_TITLE, 196, 29, 250, 16, SS_NOPREFIX
    LTEXT           "Choose how you want to connect.", IDC_UI_SUBTITLE, 196, 47, 250, 9, SS_NOPREFIX
    CONTROL         "Host address", IDC_TAB_HOST, "Button", BS_OWNERDRAW | WS_TABSTOP, 196, 62, 64, 16
    CONTROL         "Join with a code", IDC_TAB_CODE, "Button", BS_OWNERDRAW | WS_TABSTOP, 264, 62, 104, 16

    LTEXT           "Mac host address", IDC_UI_LABEL_HOST, 196, 90, 250, 9, SS_NOPREFIX
    EDITTEXT        IDC_HOST_IP, 200, 105, 242, 10, ES_AUTOHSCROLL | WS_TABSTOP | NOT WS_BORDER
    LTEXT           "Enter your Mac's Tailscale IP address, or 127.0.0.1 for Tailcat.", IDC_UI_HINT_HOST, 196, 121, 250, 9, SS_NOPREFIX
    LTEXT           "", IDC_LAUNCH_ERROR, 196, 133, 250, 18, SS_NOPREFIX
    CONTROL         "Connect to Mac", IDOK, "Button", BS_OWNERDRAW | WS_TABSTOP, 196, 154, 250, 20
    CONTROL         "Advanced settings", IDC_LAUNCH_ADVANCED, "Button", BS_OWNERDRAW | WS_TABSTOP, 196, 190, 250, 24
    LTEXT           "Joining a Mac with a pairing code is coming soon. For now, use the Mac's address on the Host address tab.", IDC_LAUNCH_CODE_NOTE, 196, 90, 250, 28, SS_NOPREFIX | NOT WS_VISIBLE

    LTEXT           "JerisLink", IDC_LAUNCH_BRAND, 18, 246, 48, 9, SS_NOPREFIX
    LTEXT           "", IDC_LAUNCH_BUILD, 70, 247, 110, 9, SS_NOPREFIX
    RTEXT           "Private connection over your tailnet", IDC_LAUNCH_PRIVACY, 196, 246, 250, 9, SS_NOPREFIX
END

// Modeless "Connection info" window: the addresses in use (read-only; set on
// the launch screen and chosen automatically), what was asked for, what the Mac is
// sending, and how this PC decodes it. Refreshes every second while open;
// video and audio keep running. Footer band from y = 205 (kInfoFooterTop).
IDD_CONNECTION_INFO DIALOGEX 0, 0, 260, 229
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_CLIPCHILDREN
CAPTION "Connection Info"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Connection info", IDC_UI_TITLE, 10, 7, 240, 13, SS_NOPREFIX
    LTEXT           "Updates every second. Video and audio keep playing.", IDC_UI_SUBTITLE, 10, 21, 240, 9, SS_NOPREFIX
    LTEXT           "ADDRESSES", IDC_INFO_SECTION_ADDRESS, 10, 37, 240, 9, SS_NOPREFIX
    LTEXT           "", IDC_INFO_ADDRESS, 10, 48, 240, 18, SS_NOPREFIX
    LTEXT           "CONFIGURED", IDC_INFO_SECTION_CONFIGURED, 10, 70, 240, 9, SS_NOPREFIX
    LTEXT           "", IDC_INFO_CONFIGURED, 10, 81, 240, 18, SS_NOPREFIX
    LTEXT           "EFFECTIVE", IDC_INFO_SECTION_EFFECTIVE, 10, 103, 240, 9, SS_NOPREFIX
    LTEXT           "", IDC_INFO_EFFECTIVE, 10, 114, 240, 36, SS_NOPREFIX
    LTEXT           "DECODER", IDC_INFO_SECTION_DECODER, 10, 154, 240, 9, SS_NOPREFIX
    LTEXT           "", IDC_INFO_DECODER, 10, 165, 240, 36, SS_NOPREFIX
    LTEXT           "", IDC_INFO_BUILD, 10, 213, 180, 9, SS_NOPREFIX
    CONTROL         "Close", IDCANCEL, "Button", BS_OWNERDRAW | WS_TABSTOP, 202, 210, 48, 14
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION JERISLINK_VERSION_MAJOR,JERISLINK_VERSION_MINOR,JERISLINK_VERSION_PATCH,0
 PRODUCTVERSION JERISLINK_VERSION_MAJOR,JERISLINK_VERSION_MINOR,JERISLINK_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Jeris\0"
            VALUE "FileDescription", "JerisLink Remote Viewer\0"
            VALUE "FileVersion", JERISLINK_VERSION_STR
            VALUE "InternalName", "Jerislink\0"
            VALUE "LegalCopyright", "Copyright 2026 jeris.org"
            VALUE "OriginalFilename", "Jerislink.exe\0"
            VALUE "ProductName", JERISLINK_PRODUCT_NAME
            VALUE "ProductVersion", JERISLINK_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
