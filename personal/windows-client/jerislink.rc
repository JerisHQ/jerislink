#include <windows.h>
#include "resource.h"

IDI_JERISLINK ICON "jerislink.ico"

IDD_VIDEO_SETTINGS DIALOGEX 0, 0, 250, 126
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "JerisLink Video Settings"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Codec:", -1, 14, 16, 62, 10
    COMBOBOX        IDC_VIDEO_CODEC, 82, 13, 148, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Bitrate (Mbps):", -1, 14, 45, 62, 10
    EDITTEXT        IDC_VIDEO_BITRATE, 82, 42, 60, 14, ES_NUMBER | WS_TABSTOP
    LTEXT           "0 = Auto. Manual range: 4-100 Mbps.", -1, 82, 60, 148, 18
    LTEXT           "Changes apply on the next JerisLink connection.", -1, 14, 84, 216, 10
    DEFPUSHBUTTON   "Save", IDOK, 126, 102, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 180, 102, 50, 14
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,0,9,5
 PRODUCTVERSION 0,0,9,5
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Jeris\0"
            VALUE "FileDescription", "JerisLink Remote Viewer\0"
            VALUE "FileVersion", "0.0.9.5\0"
            VALUE "InternalName", "Jerislink\0"
            VALUE "LegalCopyright", "Copyright (c) 2026 Jeris\0"
            VALUE "OriginalFilename", "Jerislink.exe\0"
            VALUE "ProductName", "JerisLink\0"
            VALUE "ProductVersion", "0.0.9.5\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
