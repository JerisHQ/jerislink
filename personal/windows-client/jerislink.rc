#include <windows.h>
#include "resource.h"
#include "version.h"

IDI_JERISLINK ICON "jerislink.ico"

IDD_VIDEO_SETTINGS DIALOGEX 0, 0, 260, 196
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "JerisLink Settings"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Mac host address:", -1, 14, 16, 70, 10
    EDITTEXT        IDC_HOST_IP, 90, 13, 150, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "The Mac's Tailscale IPv4 address, e.g. 100.64.0.25.", -1, 90, 30, 150, 10
    LTEXT           "This PC's address:", -1, 14, 50, 70, 10
    EDITTEXT        IDC_BIND_IP, 90, 47, 150, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "", IDC_BIND_HINT, 90, 64, 150, 18
    LTEXT           "Codec:", -1, 14, 92, 70, 10
    COMBOBOX        IDC_VIDEO_CODEC, 90, 89, 150, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Bitrate (Mbps):", -1, 14, 118, 70, 10
    EDITTEXT        IDC_VIDEO_BITRATE, 90, 115, 60, 14, ES_NUMBER | WS_TABSTOP
    LTEXT           "0 = Auto. Manual range: 4-100 Mbps.", -1, 90, 132, 150, 10
    LTEXT           "Changes apply the next time JerisLink starts.", IDC_APPLY_NOTE, 14, 152, 232, 18
    DEFPUSHBUTTON   "Save", IDOK, 136, 174, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 190, 174, 50, 14
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION JERISLINK_VERSION_MAJOR,JERISLINK_VERSION_MINOR,JERISLINK_VERSION_PATCH,0
 PRODUCTVERSION JERISLINK_VERSION_MAJOR,JERISLINK_VERSION_MINOR,JERISLINK_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Jeris\0"
            VALUE "FileDescription", "JerisLink Remote Viewer\0"
            VALUE "FileVersion", JERISLINK_VERSION_STR
            VALUE "InternalName", "Jerislink\0"
            VALUE "LegalCopyright", "Copyright 2026 jeris.org"
            VALUE "OriginalFilename", "Jerislink.exe\0"
            VALUE "ProductName", JERISLINK_PRODUCT_NAME
            VALUE "ProductVersion", JERISLINK_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
