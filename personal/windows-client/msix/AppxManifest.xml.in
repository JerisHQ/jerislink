<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest for the Microsoft Store build of the JerisLink Windows viewer.
  Identity values come from Partner Center > JerisLink > Product identity.
  @MSIX_VERSION@ is filled by build-msix.ps1 from the repository VERSION file
  as MAJOR.MINOR.PATCH.0 (the Store reserves the fourth part; it must be 0).
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:desktop2="http://schemas.microsoft.com/appx/manifest/desktop/windows10/2"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  IgnorableNamespaces="uap rescap desktop2 desktop4 desktop5 com">

  <Identity
    Name="jerisHQ.JerisLink"
    Publisher="CN=89A018EB-5C52-49CB-B478-B462FA6B08DD"
    Version="@MSIX_VERSION@"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>JerisLink</DisplayName>
    <PublisherDisplayName>jerisHQ</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="JerisLink" Executable="Jerislink.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="JerisLink"
        Description="Low-latency remote viewer for your own Mac over your Tailscale tailnet."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!--
          Explorer right-click "Send to JerisLink" for files (*) and folders
          (Directory). Windows 11 shows it in the first-level menu. Windows 10
          1809 and later meets the manifest requirements (Microsoft's schema
          docs: desktop5 ItemType and Verb 1809, desktop4
          FileExplorerContextMenus 1803, com SurrogateServer 1703), but the
          Windows 10 Explorer menu is not verified.
          The Clsid is the IExplorerCommand in JerisLinkSendTo.dll
          (send_to_shell.cpp, kClsid); it starts Jerislink.exe with the send-to option.
        -->
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type="*">
              <desktop5:Verb Id="SendToJerisLink" Clsid="8C96D31C-0D45-435B-B555-9465096C2E8A" />
            </desktop5:ItemType>
            <desktop5:ItemType Type="Directory">
              <desktop5:Verb Id="SendToJerisLink" Clsid="8C96D31C-0D45-435B-B555-9465096C2E8A" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="JerisLink Send to">
              <com:Class Id="8C96D31C-0D45-435B-B555-9465096C2E8A" Path="JerisLinkSendTo.dll" ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

  <Extensions>
    <!-- The viewer receives the video stream on UDP 38402 (viewer.cpp, video socket bind). -->
    <desktop2:Extension Category="windows.firewallRules">
      <desktop2:FirewallRules Executable="Jerislink.exe">
        <desktop2:Rule Direction="in" IPProtocol="UDP" LocalPortMin="38402" LocalPortMax="38402" Profile="all" />
      </desktop2:FirewallRules>
    </desktop2:Extension>
  </Extensions>
</Package>
