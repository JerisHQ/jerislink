#include <windows.h>
#include "@CMAKE_CURRENT_SOURCE_DIR@/resource.h"
#include "version.h"

IDI_JERISLINK ICON "@CMAKE_CURRENT_SOURCE_DIR@/jerislink.ico"
IDR_JERISLINK_EXE RCDATA "@CMAKE_CURRENT_SOURCE_DIR@/setup_payload/Jerislink.exe"
IDR_README_TXT RCDATA "@CMAKE_CURRENT_SOURCE_DIR@/setup_payload/README.txt"
IDR_UNINSTALL_CMD RCDATA "@CMAKE_CURRENT_SOURCE_DIR@/setup_payload/uninstall.cmd"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION JERISLINK_VERSION_MAJOR,JERISLINK_VERSION_MINOR,JERISLINK_VERSION_PATCH,0
 PRODUCTVERSION JERISLINK_VERSION_MAJOR,JERISLINK_VERSION_MINOR,JERISLINK_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Jeris\0"
            VALUE "FileDescription", "JerisLink Setup"
            VALUE "FileVersion", JERISLINK_VERSION_STR
            VALUE "InternalName", "JerislinkSetup\0"
            VALUE "LegalCopyright", "Copyright 2026 jeris.org"
            VALUE "OriginalFilename", "Jerislink-@JERISLINK_VERSION@-windows-x64-setup.exe"
            VALUE "ProductName", JERISLINK_PRODUCT_NAME
            VALUE "ProductVersion", JERISLINK_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
